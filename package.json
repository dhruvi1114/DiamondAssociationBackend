{
  "name": "association-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Association Management Platform — Node.js/TypeScript/Express/Prisma backend.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run copy:assets",
    "build:local": "cross-env APP_ENV=local NODE_ENV=development npm run build",
    "build:dev": "cross-env APP_ENV=dev NODE_ENV=development npm run build",
    "build:staging": "cross-env APP_ENV=staging NODE_ENV=production npm run build",
    "build:prod": "cross-env APP_ENV=production NODE_ENV=production npm run build",
    "build:interactive": "tsx scripts/build-interactive.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier \"{src,scripts,prisma}/**/*.{ts,js,json,md}\" --write",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "db:check-comments": "tsx scripts/check-db-comments.ts",
    "decrypt": "tsx scripts/decrypt.ts",
    "prepare": "husky || true",
    "copy:assets": "node -e \"require('fs').cpSync('src/locales','dist/locales',{recursive:true,filter:(s)=>!s.endsWith('.ts')}); require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "otp": "tsx scripts/show-otp.ts",
    "backfill:resubmit-links": "tsx scripts/backfill-resubmit-links.ts",
    "backfill:member-documents": "tsx scripts/backfill-member-documents.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@prisma/client": "^6.0.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "i18n": "^0.15.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pako": "^2.1.0",
    "pdfkit": "^0.20.1",
    "winston": "^3.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/i18n": "^0.13.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pako": "^2.0.3",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
