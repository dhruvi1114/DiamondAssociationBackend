/// An association event: meeting, seminar, expo.
///
/// Created as a draft, published to an audience, and priced through
/// `EventPriceTiers` rather than a fee column — the price depends on when you
/// book and on whether you are a member, so a single number cannot express it.
///
/// Enum columns are `smallint` codes, the convention for tables created from M7
/// onward. Codes are append-only.
model Event {
  /// Surrogate key.
  id BigInt @id @default(autoincrement())

  /// URL-safe identifier used in public links, so a link never exposes a row id
  /// and nobody can count the association's events by incrementing a number.
  slug String @unique @db.VarChar(160)

  /// Shown wherever the event is listed.
  title String @db.VarChar(200)

  /// Long description, rendered on the detail page.
  description String? @db.Text

  /// Storage key of the banner image, through `@helpers/storage`.
  banner_path String? @db.Text

  /// Event start (UTC).
  start_at DateTime @db.Timestamptz(6)

  /// Event end (UTC). CHECK end_at > start_at.
  end_at DateTime @db.Timestamptz(6)

  /// Venue name as it appears on the invitation.
  venue_name String? @db.VarChar(200)

  /// Street address, line 1.
  venue_address_line1 String? @db.VarChar(200)

  /// Street address, line 2.
  venue_address_line2 String? @db.VarChar(200)

  /// City. Free text rather than an FK to Cities: a venue may sit outside the
  /// master list, and this is a printed address, not a searchable dimension.
  city String? @db.VarChar(100)

  /// State.
  state String? @db.VarChar(100)

  /// Postal code.
  pincode String? @db.VarChar(10)

  /// Country.
  country String @default("India") @db.VarChar(100)

  /// Optional map link shown on the detail page.
  map_url String? @db.Text

  /// 0 = MEMBER_ONLY, 1 = PUBLIC. Member-only events are absent from every
  /// public query rather than fetched and hidden — a 403 would confirm they exist.
  visibility Int @default(0) @db.SmallInt

  /// 0 = DRAFT, 1 = PUBLISHED, 2 = CANCELLED, 3 = COMPLETED.
  status Int @default(0) @db.SmallInt

  /// GST or other tax applied on top of the tier price, percent, 2dp.
  tax_rate Decimal @default(0) @db.Decimal(5, 2)

  /// Total seats. NULL means unlimited.
  capacity Int?

  /// Seats consumed by live registrations. Maintained by one guarded UPDATE
  /// inside the registration transaction, never by read-then-write, so
  /// simultaneous bookings cannot oversell the room.
  seats_taken Int @default(0)

  /// When registration opens. NULL means "as soon as it is published".
  registration_opens_at DateTime? @db.Timestamptz(6)

  /// When registration closes. CHECK it is on or before the event starts.
  registration_closes_at DateTime? @db.Timestamptz(6)

  /// When true, a registration waits for admin approval before an invoice
  /// exists. Off by default; used for AGMs and vetted delegations.
  requires_approval Boolean @default(false)

  /// Collect Veg/Non-veg/Jain per delegate.
  collect_food_preference Boolean @default(true)

  /// Collect a badge photo per delegate.
  collect_photo Boolean @default(false)

  /// Collect a government ID per delegate.
  collect_gov_id Boolean @default(false)

  /// Version of the terms shown at booking. Stored on each registration too, so
  /// an old booking still proves which policy the payer actually accepted.
  terms_version String @default("v1") @db.VarChar(20)

  /// Row creation timestamp (UTC).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Member login that created this row. Always NULL today; events are staff-made.
  created_by_user_id BigInt?

  /// Staff account that created this row.
  created_by_admin_id BigInt?

  /// Last modification timestamp (UTC).
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Member login that last changed this row.
  updated_by_user_id BigInt?

  /// Staff account that last changed this row.
  updated_by_admin_id BigInt?

  /// Soft-delete timestamp (UTC). NULL means live; all reads filter on it.
  deletedAt DateTime? @db.Timestamptz(6)

  /// The price windows for this event.
  price_tiers        EventPriceTier[]
  eventRegistrations EventRegistration[]

  @@index([status, visibility, start_at])
  @@map("Events")
}

/// One price window for one event.
///
/// Two prices per row — member and non-member — and an exclusion constraint
/// guarantees the windows never overlap, so "which price applies today" always
/// has exactly one answer instead of depending on row order.
model EventPriceTier {
  /// Surrogate key.
  id BigInt @id @default(autoincrement())

  /// FK to Events.id. ON DELETE CASCADE — a tier is meaningless without its event.
  event_id BigInt

  /// Label shown to the buyer: "Early bird", "Regular", "Late".
  name String @db.VarChar(60)

  /// First day this price applies, inclusive.
  starts_on DateTime @db.Date

  /// Last day this price applies, inclusive — a tier runs to the end of its last day.
  ends_on DateTime @db.Date

  /// Price per delegate for a member, INR, 2dp. 0 for a free event.
  member_price Decimal @db.Decimal(14, 2)

  /// Price per delegate for everyone else, INR, 2dp.
  non_member_price Decimal @db.Decimal(14, 2)

  /// Ordering on the admin form and the public price table.
  display_order Int @default(0)

  /// Row creation timestamp (UTC).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Member login that created this row. Always NULL today.
  created_by_user_id BigInt?

  /// Staff account that created this row.
  created_by_admin_id BigInt?

  /// Last modification timestamp (UTC).
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Member login that last changed this row.
  updated_by_user_id BigInt?

  /// Staff account that last changed this row.
  updated_by_admin_id BigInt?

  /// The event priced.
  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([event_id, starts_on])
  @@map("EventPriceTiers")
}

/// A non-member who registered for a public event.
///
/// Not a login: no password, no `Users` row, no session. A guest is the customer
/// of one event, and giving them an account would make them a platform user with
/// data scoping, roles and a lifecycle nobody asked for.
///
/// Everything here is typed by the guest themselves, because the platform holds
/// nothing about them to pre-fill.
model GuestRegistrant {
  /// Surrogate key.
  id BigInt @id @default(autoincrement())

  /// The person attending and being billed.
  full_name String @db.VarChar(150)

  /// Job title, for the badge and the attendee list.
  designation String? @db.VarChar(100)

  /// Their firm's name, as it should appear on the invoice.
  company_name String? @db.VarChar(200)

  /// Where the confirmation and the ticket code are sent.
  email String @db.Citext

  /// Day-of contact number.
  phone String? @db.VarChar(20)

  /// GSTIN, so the invoice can carry it. Optional: not every guest has one.
  gst_number String? @db.VarChar(20)

  /// PAN, for TDS cases.
  pan_number String? @db.VarChar(10)

  /// Billing address, line 1.
  line1 String? @db.VarChar(200)

  /// Billing address, line 2.
  line2 String? @db.VarChar(200)

  /// City.
  city String? @db.VarChar(100)

  /// State.
  state String? @db.VarChar(100)

  /// Postal code.
  pincode String? @db.VarChar(10)

  /// Country.
  country String @default("India") @db.VarChar(100)

  /// Row creation timestamp (UTC).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Member login that created this row. Always NULL: guests have no login.
  created_by_user_id BigInt?

  /// Staff account that created this row, when staff registered someone by hand.
  created_by_admin_id BigInt?

  /// Last modification timestamp (UTC).
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Member login that last changed this row.
  updated_by_user_id BigInt?

  /// Staff account that last changed this row.
  updated_by_admin_id BigInt?

  /// Invoices raised against this guest.
  invoices Invoice[]

  /// Payments this guest has made.
  payments Payment[]

  @@index([email])
  @@map("GuestRegistrants")
}

/// One booking: a company (or a guest) taking seats at an event.
///
/// The people are on `EventRegistrationAttendees` — this row is the booking, the
/// money and the state. There is no attendance table: this module records who is
/// *going* to attend, not who turned up on the day, which is deliberately out of
/// scope and can be added later without touching anything here.
model EventRegistration {
  /// Surrogate key.
  id BigInt @id @default(autoincrement())

  /// FK to Events.id. ON DELETE NO ACTION — an event with bookings is cancelled,
  /// never deleted out from under them.
  event_id BigInt

  /// 0 = MEMBER, 1 = GUEST.
  registrant_type Int @db.SmallInt

  /// FK to Members.id when a member booked. Exactly one of this and
  /// `guest_registrant_id` is set, enforced by a CHECK.
  member_id BigInt?

  /// The login that pressed the button, for the audit trail. NULL for a guest.
  user_id BigInt?

  /// FK to GuestRegistrants.id when a non-member booked.
  guest_registrant_id BigInt?

  /// The booking's own reference, quoted in emails and to the office.
  registration_code String @unique @db.VarChar(30)

  /// 0 PENDING_APPROVAL · 1 PENDING_PAYMENT · 2 PAYMENT_UNDER_VERIFICATION
  /// 3 CONFIRMED · 4 EXPIRED · 5 CANCELLED · 6 REJECTED · 7 REFUNDED
  status Int @db.SmallInt

  /// How many seats this booking holds. Kept in step with the attendee rows.
  attendee_count Int @default(1)

  /// The tier in force when the booking was made. The price is frozen per
  /// attendee; this records which window produced it.
  price_tier_id BigInt?

  /// Sum of the frozen attendee prices, INR, 2dp.
  subtotal Decimal @db.Decimal(14, 2)

  /// Tax on the subtotal at the event's rate.
  tax_amount Decimal @default(0) @db.Decimal(14, 2)

  /// What is owed.
  total_amount Decimal @db.Decimal(14, 2)

  /// The invoice raised for it. NULL for a free event, and until approval on an
  /// event that requires it — which is the point: rejecting costs nothing to
  /// reverse because no invoice ever existed.
  invoice_id BigInt?

  /// When the held seats are released if nobody pays. Set from
  /// `event.payment_hold_days`, and re-set at approval so an admin's delay never
  /// eats the payer's window.
  expires_at DateTime? @db.Timestamptz(6)

  /// When staff approved it, on an event that requires approval.
  approved_at DateTime? @db.Timestamptz(6)

  /// Which staff account approved it.
  approved_by_admin_id BigInt?

  /// Why it was refused. Mandatory when status is REJECTED.
  rejection_reason String? @db.Text

  /// When the booker accepted the terms. Stored, not inferred: this is what the
  /// association quotes back in a refund dispute.
  terms_accepted_at DateTime @db.Timestamptz(6)

  /// Which version of the terms they accepted.
  terms_version String @db.VarChar(20)

  /// Whether they consented to event photography.
  media_consent Boolean @default(false)

  /// Billing snapshot, frozen at booking so a later profile edit cannot rewrite
  /// what an old invoice said.
  billing_company_name String? @db.VarChar(200)

  /// GSTIN as it was at booking.
  gst_number String? @db.VarChar(20)

  /// PAN as it was at booking.
  pan_number String? @db.VarChar(10)

  /// IEC code as it was at booking.
  iec_code String? @db.VarChar(20)

  /// Billing address line 1, frozen.
  billing_line1 String? @db.VarChar(200)

  /// Billing address line 2, frozen.
  billing_line2 String? @db.VarChar(200)

  /// Billing city, frozen.
  billing_city String? @db.VarChar(100)

  /// Billing state, frozen.
  billing_state String? @db.VarChar(100)

  /// Billing pincode, frozen.
  billing_pincode String? @db.VarChar(10)

  /// Billing country, frozen.
  billing_country String? @db.VarChar(100)

  /// Who to contact about this booking.
  contact_name String? @db.VarChar(150)

  /// Where correspondence about this booking goes.
  contact_email String? @db.Citext

  /// Day-of contact number for the booking.
  contact_phone String? @db.VarChar(20)

  /// 0 = MEMBER, 1 = ADMIN, 2 = SYSTEM. Who ended it, when it was ended.
  cancelled_by Int? @db.SmallInt

  /// When it was cancelled or expired.
  cancelled_at DateTime? @db.Timestamptz(6)

  /// When the booking was made. The date that decides the price tier.
  registered_at DateTime @default(now()) @db.Timestamptz(6)

  /// Row creation timestamp (UTC).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Member login that created this row.
  created_by_user_id BigInt?

  /// Staff account that created this row, when staff booked on someone's behalf.
  created_by_admin_id BigInt?

  /// Last modification timestamp (UTC).
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Member login that last changed this row.
  updated_by_user_id BigInt?

  /// Staff account that last changed this row.
  updated_by_admin_id BigInt?

  /// Soft-delete timestamp (UTC).
  deletedAt DateTime? @db.Timestamptz(6)

  /// The event booked.
  event Event @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: Cascade)

  /// The people this booking is for.
  attendees EventRegistrationAttendee[]

  @@index([event_id, status])
  @@index([status, expires_at])
  @@index([member_id, registered_at(sort: Desc)])
  @@map("EventRegistrations")
}

/// One person on a booking — the answer to "who is going to attend".
///
/// A row per delegate rather than a count, so the attendee report lists people
/// rather than "ABC Pvt Ltd — 3", and so each person can be emailed their own
/// code. Name, designation and price are snapshots: an attendee report from last
/// year still shows what was true then.
model EventRegistrationAttendee {
  /// Surrogate key.
  id BigInt @id @default(autoincrement())

  /// FK to EventRegistrations.id. ON DELETE CASCADE — owned by the booking.
  registration_id BigInt

  /// FK to MemberUsers.id — which team login this delegate is. NULL for a guest,
  /// and SET NULL if the team row is ever removed: the booking still names them.
  member_user_id BigInt?

  /// This person's own code, the one in their confirmation email.
  attendee_code String @unique @db.VarChar(30)

  /// Name as it should appear on the badge and the entry list.
  full_name String @db.VarChar(150)

  /// Job title, snapshot.
  designation String? @db.VarChar(100)

  /// Where this person's own confirmation goes.
  email String? @db.Citext

  /// Day-of contact number.
  phone String? @db.VarChar(20)

  /// The price frozen for this person, INR, 2dp. Frozen at booking, which is why
  /// paying three weeks later never changes what is owed.
  unit_price Decimal @db.Decimal(14, 2)

  /// 0 = VEG, 1 = NON_VEG, 2 = JAIN. Collected only when the event asks.
  food_preference Int? @db.SmallInt

  /// Storage key of the badge photo, when the event asks for one.
  photo_path String? @db.Text

  /// 0 AADHAAR · 1 PAN · 2 PASSPORT · 3 DL · 4 VOTER.
  id_type Int? @db.SmallInt

  /// The ID number, when the venue requires one.
  id_number String? @db.VarChar(50)

  /// Wheelchair access, dietary need, interpreter — anything the venue must know.
  special_requirement String? @db.Text

  /// Row creation timestamp (UTC).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Member login that created this row.
  created_by_user_id BigInt?

  /// Staff account that created this row.
  created_by_admin_id BigInt?

  /// Last modification timestamp (UTC).
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Member login that last changed this row.
  updated_by_user_id BigInt?

  /// Staff account that last changed this row.
  updated_by_admin_id BigInt?

  /// The booking this person is on.
  registration EventRegistration @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([registration_id])
  @@index([email])
  @@map("EventRegistrationAttendees")
}
