/// Delivery channel for a notification. IN_APP has no external provider — the row itself is
/// the member's bell-feed item (notification-architecture.md §6).
enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

/// Outbox lifecycle. QUEUED → SENDING → SENT, or → FAILED after the retry budget is spent.
/// CANCELLED is an administrative stop for a row that should no longer go out.
enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// The authored content for one message, per channel and locale. Content lives in rows rather
/// than in code so the association can reword a message without a deploy
/// (notification-architecture.md §4).
model NotificationTemplate {
  /// Surrogate key.
  id BigInt @id @default(autoincrement())

  /// Message identifier, e.g. auth.signup_otp. Services queue by this code, so it is a
  /// contract and is never renamed once released.
  code String @db.VarChar(80)

  /// Channel this rendering is for: EMAIL, WHATSAPP or IN_APP. The same code exists once per
  /// channel because an SMS and an email say the same thing at very different lengths.
  channel NotificationChannel

  /// BCP-47-ish language tag, matching APP_LANGUAGES. Defaults to en.
  locale String @default("en") @db.VarChar(10)

  /// Email subject line, with {{placeholders}}. NULL for channels that have no subject.
  subject String? @db.VarChar(200)

  /// Message body with {{placeholders}} substituted from Notifications.payload_json. Plain
  /// text or simple HTML; never rendered with dangerouslySetInnerHTML on the client.
  body String @db.Text

  /// Soft on/off switch used instead of deletion so historic references stay resolvable.
  is_active Boolean @default(true)

  /// Row creation timestamp (UTC).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Last modification timestamp (UTC).
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([code, channel, locale])
  @@map("NotificationTemplates")
}

/// The notification outbox (ADR-010/ADR-015): one row per message per recipient per channel.
/// Services INSERT here inside the same transaction as the business change and never call a
/// provider inline, so a dead mail server can never roll back an approval. A drain job
/// dispatches, retries with backoff, and gives up visibly rather than silently.
model Notification {
  /// Surrogate key.
  id BigInt @id @default(autoincrement())

  /// FK to Users.id — the member recipient. ON DELETE CASCADE. NULL when the recipient is
  /// staff. Exactly one of user_id / admin_user_id is set.
  user_id BigInt?

  /// FK to AdminUsers.id — the staff recipient. ON DELETE CASCADE. NULL for member messages.
  admin_user_id BigInt?

  /// Members.id this message concerns, for filtering an organisation's message history.
  /// Column exists from M0; the foreign key is added in M3 with the Members table, because
  /// the outbox is built before the membership model (ADR-015).
  member_id BigInt?

  /// Delivery channel: EMAIL, WHATSAPP or IN_APP.
  channel NotificationChannel

  /// NotificationTemplates.code to render. Resolved at drain time with channel + locale, so
  /// a reworded template applies to messages already queued.
  template_code String @db.VarChar(80)

  /// Template variables, e.g. {"full_name":"…","otp":"…"}. Documented JSON use: these are
  /// per-message substitutions, not relational data. Never logged — it can hold an OTP.
  payload_json Json

  /// Resolved destination: email address, or phone number for WhatsApp. NULL for IN_APP,
  /// which has no address. Snapshotted at queue time so a later profile edit cannot silently
  /// redirect a message that has already been raised.
  to_address String? @db.VarChar(200)

  /// Where a reply should go, when that is not the sending account.
  ///
  /// Exists for messages the platform sends *on somebody's behalf* -- a contact
  /// enquiry is from the platform but about a visitor, and without this the
  /// office pressing Reply writes to the no-reply account instead of them.
  reply_to String? @db.VarChar(200)

  /// Outbox state: QUEUED, SENDING, SENT, FAILED, CANCELLED.
  status NotificationStatus @default(QUEUED)

  /// Delivery attempts made so far. The drain gives up at 5 (notification-architecture.md §8).
  attempt_count Int @default(0)

  /// Earliest instant (UTC) this row may be picked up again — now + 2^attempt minutes after a
  /// failure. Paired with status in the drain index; NULL means never retry.
  next_attempt_at DateTime? @db.Timestamptz(6)

  /// When the provider accepted the message (UTC). NULL until SENT.
  sent_at DateTime? @db.Timestamptz(6)

  /// Last failure reason, kept so a FAILED row in the admin outbox explains itself. Provider
  /// message only; never a stack trace and never the rendered body.
  error String? @db.Text

  /// When the member opened this IN_APP item (UTC). NULL means unread; drives the bell badge.
  /// Always NULL for EMAIL and WHATSAPP, which have no read signal.
  read_at DateTime? @db.Timestamptz(6)

  /// Row creation timestamp (UTC) — when the business event queued the message.
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Last modification timestamp (UTC) — bumped on every delivery attempt.
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user       User?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin_user AdminUser? @relation(fields: [admin_user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status, next_attempt_at])
  @@index([user_id, channel, read_at])
  @@index([admin_user_id, channel, read_at])
  @@index([member_id])
  @@map("Notifications")
}

/// An enquiry sent from the public contact form.
///
/// Stored before the office is emailed, and that order is the point: a message
/// that only ever existed as an email is lost the moment SMTP fails, and nobody
/// ever learns it was sent. The row survives any mail failure, and the outbox
/// retries the notification on its own.
///
/// Not tied to a member. Most people who use this form are not members yet --
/// that is usually why they are writing.
/// A message from the public contact form.
///
/// The row is written before the office is emailed. A message that only ever existed as an email
/// is gone the moment SMTP fails, and nobody ever learns it was sent — which is the one failure a
/// contact form cannot be allowed to have.
model ContactEnquiry {
  /// Surrogate key.
  id BigInt @id @default(autoincrement())

  /// Sender's name, as typed.
  name String @db.VarChar(150)

  /// Sender's email. Where a reply goes, so it is required even though the rest
  /// of the form is forgiving.
  email String @db.VarChar(200)

  /// Optional phone. Some enquirers would rather be called than written to.
  phone String? @db.VarChar(20)

  /// What it is about, in the sender's words.
  subject String @db.VarChar(200)

  /// The enquiry itself.
  message String @db.Text

  /// 0 = NEW, 1 = HANDLED. Deliberately two states: this is a to-do list, not a
  /// helpdesk, and a third state would need someone to define what it means.
  status Int @default(0) @db.SmallInt

  /// Staff account that dealt with it. NULL while still NEW.
  handled_by_admin_id BigInt?

  /// When it was marked dealt with.
  handled_at DateTime? @db.Timestamptz(6)

  /// Where it came from. Kept for abuse investigation only -- never displayed
  /// beside the message, because an IP tells staff nothing about the enquiry.
  ip String? @db.VarChar(64)

  /// Row creation timestamp (UTC).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Last modification timestamp (UTC). Carries a DB default as well as Prisma's `@updatedAt`,
  /// matching the migration that created the column.
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  /// Soft-delete timestamp (UTC). NULL means active.
  deletedAt DateTime? @db.Timestamptz(6)

  handled_by AdminUser? @relation("ContactEnquiryHandledBy", fields: [handled_by_admin_id], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([handled_by_admin_id])
  @@map("ContactEnquiries")
}
