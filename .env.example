# =============================================================================
# Association Platform — backend environment template
# =============================================================================
# The loader reads base `.env` first, then overlays `.env.<APP_ENV>`
# (.env.local | .env.dev | .env.staging | .env.production). Every key below is
# validated by src/config/config.ts at boot — a missing or malformed required
# key aborts startup, it never falls back to an insecure default.
#
# NEVER commit a real .env* file. Only this example is tracked.
# Give every environment its own CHIPER/TERIFF/PLAN and JWT secrets
# (security.md §4.4 — key rotation is a coordinated backend + frontend release).
# =============================================================================

# ---- runtime ----------------------------------------------------------------
NODE_ENV=development                 # development | test | production
APP_ENV=local                        # local | dev | staging | production
PORT=4000                            # 4000 backend · 3000 customer · 3001 admin (versions.md)
PUBLIC_BASE_URL=http://localhost:4000 # externally reachable base URL of this API

# ---- database ---------------------------------------------------------------
# Also read directly by the Prisma CLI, so it must live in the base `.env` too.
DATABASE_URL=postgresql://user:password@localhost:5432/association_platform_local

# ---- auth (rbac.md §1) ------------------------------------------------------
JWT_SECRET=change-me-to-a-32-byte-random-hex-string
JWT_REFRESH_SECRET=change-me-to-a-different-32-byte-random-hex-string
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_REFRESH_EXPIRES_IN=1d

# ---- payload encryption (ADR-004) ------------------------------------------
# CHIPER = algorithm label, TERIFF = 32-char AES-256 key, PLAN = 16-char IV.
# TERIFF/PLAN are mirrored by the frontends (they are public by construction —
# see security.md §4: this is obfuscation, not a confidentiality boundary).
CHIPER=aes-256-cbc
TERIFF=00000000000000000000000000000000
PLAN=0000000000000000

# ---- i18n -------------------------------------------------------------------
APP_LANGUAGES=en                     # comma separated; first entry is the default locale

# ---- http -------------------------------------------------------------------
# Comma separated exact origins. "*" is rejected by the config loader.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY_HOPS=1                   # app.set('trust proxy', n) — real client IP behind nginx

# ---- storage (ADR-017 / file-storage.md) ------------------------------------
STORAGE_DRIVER=local                 # local | s3
# MUST sit outside the repo and outside every web root. KYC files live here.
STORAGE_PATH=/absolute/path/outside/the/repo/association-storage

# ---- jobs (ADR-009) ---------------------------------------------------------
ENABLE_JOBS=true                     # only ONE instance may run jobs

# ---- mail (ADR-015 / A-13) --------------------------------------------------
MAIL_TRANSPORT=console               # console = log instead of send; smtp = real delivery
MAIL_FROM=Association Platform <no-reply@example.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CRASH_MAIL=                          # ops mailbox notified on uncaught exceptions

# ---- seeds (rbac.md §8 — no default credentials in code) --------------------
# QUOTE any secret containing '#'. dotenv treats an unquoted '#' as the start of
# an inline comment even with no space before it, so
#   SEED_SUPERADMIN_PASSWORD=Sup3rSecret#2026
# is silently loaded as "Sup3rSecret" — the seed then hashes a password that is
# not the one written here, and the login fails for a reason nothing reports.
# Same rule for SMTP_PASSWORD, JWT secrets and DATABASE_URL passwords.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=""

# ---- observability (observability.md) ---------------------------------------
LOG_LEVEL=info                       # error | warn | info | debug
SLOW_REQUEST_MS=1000                 # requests slower than this log at warn

# ---- rate limiting (api-conventions.md §9) ----------------------------------
RATE_LIMIT_WINDOW_MS=900000          # 15 minutes
RATE_LIMIT_MAX=300                   # global cap per IP per window

# --- Per-role test staff (local/dev only; rbac suite coverage) ---
# Refuses to run when APP_ENV is staging/production. No defaults, by design.
SEED_TEST_ADMINS=true
SEED_TEST_ADMIN_EMAIL=admin.test@lgdgf.local
SEED_TEST_ADMIN_PASSWORD=__at_least_12_chars__
SEED_TEST_APPROVER_EMAIL=approver.test@lgdgf.local
SEED_TEST_APPROVER_PASSWORD=__at_least_12_chars__
SEED_TEST_ACCOUNTS_EMAIL=accounts.test@lgdgf.local
SEED_TEST_ACCOUNTS_PASSWORD=__at_least_12_chars__
